<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="4.0" client="site" method="upgrade">
    <name>MOD_B3_CAROUSEL</name>
    <author>Hugo Fittipaldi</author>
    <creationDate>April 2016</creationDate>
    <copyright>Copyright (C) 2020 Hugo Fittipaldi. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>hugo.fittipaldi@gmail.com</authorEmail>
    <authorUrl>https://github.com/hfittipaldi/mod_b3_carousel</authorUrl>
    <version>3.0.1</version>
    <description>MOD_B3_CAROUSEL_XML_DESCRIPTION</description>
    <namespace path="src">Joomla\Module\B3Carousel</namespace>
    <files>
        <folder module="mod_b3_carousel">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <filename>item.xml</filename>
    </files>
    <scriptfile>script.php</scriptfile>
    <media destination="mod_b3_carousel" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>js</folder>
    </media>
    <languages>
        <language tag="en-GB">language/en-GB/mod_b3_carousel.ini</language>
        <language tag="en-GB">language/en-GB/mod_b3_carousel.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic" addfieldpath="/administrator/components/com_content/models/fields">
                <field
                    name="slides"
                    type="subform"
                    formsource="modules/mod_b3_carousel/item.xml"
                    class="advancedSelect"
                    min="1"
                    max="10"
                    multiple="true"
                    layout="joomla.form.field.subform.repeatable"
                    groupByFieldset="true"
                    label="MOD_B3_CAROUSEL_FIELD_SLIDES_LABEL"
                    description="MOD_B3_CAROUSEL_FIELD_SLIDES_DESC"
                    filter="integer"
                />
            </fieldset>

            <fieldset name="controls" label="Controls">
                <field
                    name="autoslide"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_B3_CAROUSEL_FIELD_AUTOSLIDE_LABEL"
                    description="MOD_B3_CAROUSEL_FIELD_AUTOSLIDE_DESC"
                    default="1"
                    filter="boolean"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="transition"
                    type="list"
                    default="0"
                    label="MOD_B3_CAROUSEL_FIELD_TRANSITION_LABEL"
                    description="MOD_B3_CAROUSEL_FIELD_TRANSITION_DESC"
                    filter="integer"
                >
                    <option value="0">Default</option>
                    <option value="1">Fade</option>
                </field>

                <field
                    name="interval"
                    type="text"
                    default="5000"
                    label="MOD_B3_CAROUSEL_FIELD_INTERVAL_LABEL"
                    description="MOD_B3_CAROUSEL_FIELD_INTERVAL_DESC"
                    filter="integer"
                />

                <field
                    name="indicators"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_B3_CAROUSEL_FIELD_INDICATORS_LABEL"
                    description="MOD_B3_CAROUSEL_FIELD_INDICATORS_DESC"
                    default="1"
                    filter="boolean"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="controls"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_B3_CAROUSEL_FIELD_CONTROLS_LABEL"
                    description="MOD_B3_CAROUSEL_FIELD_CONTROLS_DESC"
                    default="1"
                    filter="boolean"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="pause"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_B3_CAROUSEL_FIELD_PAUSE_LABEL"
                    description="MOD_B3_CAROUSEL_FIELD_PAUSE_DESC"
                    default="1"
                    filter="boolean"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="wrap"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_B3_CAROUSEL_FIELD_WRAP_LABEL"
                    description="MOD_B3_CAROUSEL_FIELD_WRAP_DESC"
                    default="1"
                    filter="boolean"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="keyboard"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_B3_CAROUSEL_FIELD_KEYBOARD_LABEL"
                    description="MOD_B3_CAROUSEL_FIELD_KEYBOARD_DESC"
                    default="1"
                    filter="boolean"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>

            <fieldset name="advanced">
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    class="form-select"
                    validate="moduleLayout"
                />

                <field
                    name="moduleclass_sfx"
                    type="textarea"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    rows="3"
                    validate="CssIdentifier"
                />

                <field
                    name="cache"
                    type="list"
                    label="COM_MODULES_FIELD_CACHING_LABEL"
                    default="1"
                    filter="integer"
                    validate="options"
                >
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>

                <field
                    name="cache_time"
                    type="number"
                    label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                    default="900"
                    filter="integer"
                />

                <field
                    name="cachemode"
                    type="hidden"
                    default="static"
                >
                    <option value="static"></option>
                </field>
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" priority="1" name="B3 Carousel Module Update Site">https://raw.githubusercontent.com/hfittipaldi/mod_b3_carousel/master/updates.xml</server>
    </updateservers>
</extension>
